---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  credit?: string;
  width: number;
  widths: number[];
  sizes: string;
  eager?: boolean;
  ratio?: string;
}
const { src, alt, credit, width, widths, sizes, eager, ratio } = Astro.props;
---
<figure style={ratio ? `--ratio:${ratio}` : undefined} class={ratio ? 'cropped' : undefined}>
  <Image {src} {alt} {width} {widths} {sizes} loading={eager ? 'eager' : 'lazy'} />
  {credit && <figcaption class="credit">{credit}</figcaption>}
</figure>
<style>
  figure { margin: 0; }
  figure :global(img) { border-radius: var(--r3); }
  /* Cropping is opt-in: an uncropped figure keeps the photographer's framing. */
  .cropped :global(img) { aspect-ratio: var(--ratio); object-fit: cover; width: 100%; }
</style>
