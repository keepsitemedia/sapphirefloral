---
interface Props { heading?: string; body?: string }
const {
  heading = 'Let’s design your day',
  body = 'Tell me about your wedding or event. I’d love to be your florist.',
} = Astro.props;
---
<section class="ground-sapphire cta">
  <div class="wrap inner">
    <hr class="rule" />
    <h2>{heading}</h2>
    <p>{body}</p>
    <a class="btn btn-light" href="/contact">Start an inquiry</a>
  </div>
</section>
<style>
  .cta { padding-block: var(--s6); }
  .inner { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s3); }
  .inner p { color: var(--on-sapphire-soft); font-size: 1.1rem; }
  .inner .btn { margin-top: var(--s2); }
</style>
