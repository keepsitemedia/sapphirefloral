---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Sapphire Stem Floral Design" description="That page has wilted. Browse the portfolio or get in touch — Sapphire Stem Floral Design, Montana wedding florist." noindex>
  <section class="ground-sapphire panel">
    <div class="wrap-narrow inner">
      <hr class="rule" />
      <h1>That page has wilted</h1>
      <p>The page you’re looking for doesn’t exist. The flowers, however, are right this way.</p>
      <a class="btn btn-light" href="/portfolio">See the portfolio</a>
    </div>
  </section>
</Base>
<style>
  .panel { padding-block: var(--s7); }
  .inner { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s3); }
  .inner p { color: var(--on-sapphire-soft); font-size: 1.1rem; }
  .inner .btn { margin-top: var(--s2); }
</style>
