---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you — Sapphire Stem Floral Design" description="Your inquiry is in. Beka will get back to you within a few days about your Montana wedding or event flowers." noindex>
  <section class="ground-sapphire panel">
    <div class="wrap-narrow inner">
      <hr class="rule" />
      <h1>Thank you</h1>
      <p>Your inquiry is on its way. I’ll be in touch within a few days — in the meantime, the portfolio is right this way.</p>
      <a class="btn btn-light" href="/portfolio">See recent work</a>
    </div>
  </section>
</Base>
<style>
  .panel { padding-block: var(--s7); }
  .inner { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s3); }
  .inner p { color: var(--on-sapphire-soft); font-size: 1.1rem; }
  .inner .btn { margin-top: var(--s2); }
</style>
